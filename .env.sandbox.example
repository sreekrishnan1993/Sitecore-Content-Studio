# Content Studio — private sandbox test configuration.
# Copy to .env.production.local, fill in the tenant, then:
#   npm run build && npm run start:sandbox && npm run preflight -- --url http://localhost:3000
# Never use these values on a publicly reachable server.

# Marks this deployment as a sandbox. Live writes are then allowed only to the tenant below.
CONTENT_STUDIO_DEPLOYMENT=sandbox
# Tenant name, display name, tenant ID or resource ID of the sandbox environment
# (shown in Content Studio under Settings → Sitecore integration → Tenant).
CONTENT_STUDIO_SANDBOX_TENANT=

# Unauthenticated extraction: sandbox only, server bound to 127.0.0.1, synthetic documents only.
CONTENT_STUDIO_AUTH_MODE=none
CONTENT_STUDIO_ALLOW_UNAUTHENTICATED=true

# Not needed for the Sitecore test.
CONTENT_STUDIO_ENABLE_URL_IMPORT=false
